---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import projects from "@pages/projects/_projects.json"
import { SITE, HOME, SOCIALS } from "@consts";
import Project from "@components/Project.astro";


const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

const homeProjects = projects
//@ts-expect-error
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);
---
<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white">
      Hi <span class="text-xl">👋🏻</span>,
    </h4>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
      <p class="animate">
      I'm Ansah Peter, i build low level && backend systems. I've always had the itch to understand how things work, 
      bold enough to look into the black box. Lately I find myself building exactly once, guarantee delivery, 
     replayable async messaging systems at 
     <a href="https://ingest.africa/" class="underline underline-offset-2 decoration-black/20 dark:decoration-white/30 hover:decoration-black/40 hover:dark:decoration-white/60">Ingest Africa</a>.
      I’m fascinated by OS internals like virtualizations, linux namespaces and sandboxes
      </p>
        </article>
      </section>
      <section class="animate space-y-4">
        <p class="text-black/70 dark:text-white/70 italic">
          Currently reading: <span class="font-semibold">Systems Performance Enterprise and the Cloud</span> by Brendan Gregg
        </p>
      </section>
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Recent projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="animate flex flex-col gap-4">
          {homeProjects.map(project => (
            <li class="relative group flex flex-col gap-3 py-4 px-5 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300 ease-in-out">
              <Project {...project} />
            </li>
          ))}
        </ul>
      </section>
      <section class="animate space-y-4">
        <h5 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h5>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              mail
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
